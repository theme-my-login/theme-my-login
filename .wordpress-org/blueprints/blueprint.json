{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/login/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "theme-my-login"
			}
		},
		{
			"step": "setSiteOptions",
			"options": {
				"users_can_register": "1",
				"permalink_structure": "/%postname%/"
			}
		},
		{
			"step": "wp-cli",
			"command": "wp rewrite flush"
		}
	]
}
